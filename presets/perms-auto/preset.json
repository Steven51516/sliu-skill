{
  "about": "permissions, pick one: Claude's auto mode (a classifier checks each action instead of asking you; a blanket Bash(*) allow rule is set for the other modes, auto mode ignores it) and Codex sandboxed, never asking; history rewrites and PRs ask you; deletes follow the deletes-* choice",
  "group": "permissions",
  "settings": {
    "permissions.defaultMode": "auto",
    "permissions.allow": [
      "Bash(*)"
    ],
    "permissions.ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git tag -d *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo delete *)"
    ]
  },
  "codex_config": {
    "approval_policy": "never",
    "sandbox_mode": "workspace-write"
  }
}
