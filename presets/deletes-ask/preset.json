{
  "about": "a recursive delete asks you; unanswered for 15 min, it is declined: use trash",
  "group": "deletes",
  "was": [
    "safe-deletes"
  ],
  "path": {
    "trash": "extras/trash.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/research-harness/extras/delete-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "settings": {
    "permissions.ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)"
    ]
  },
  "claude_md": "claude.md",
  "codex_md": "codex.md",
  "order": 1
}
