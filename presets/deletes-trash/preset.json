{
  "about": "a recursive delete is refused at once: use trash",
  "group": "deletes",
  "path": {
    "trash": "extras/trash.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/research-harness/extras/delete-guard.py --policy trash",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "claude_md": "claude.md",
  "codex_md": "codex.md",
  "order": 2
}
